FROM rust:1.85.1-bookworm@sha256:e51d0265072d2d9d5d320f6a44dde6b9ef13653b035098febd68cce8fa7c0bc4
RUN apt-get update && apt-get install -y --no-install-recommends qemu-system-x86 python3 python3-cryptography python3-jsonschema python3-venv binutils && rm -rf /var/lib/apt/lists/*
RUN rustup target add i686-unknown-linux-musl
RUN python3 -m venv /opt/genesis-python && /opt/genesis-python/bin/pip install --no-cache-dir cryptography==50.0.2 jsonschema==4.26.0 z3-solver==4.13.4.0
ENV PATH="/opt/genesis-python/bin:${PATH}"
ENV CARGO_BUILD_JOBS=2
WORKDIR /work
